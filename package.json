{
  "name": "tmplat",
  "version": "2.0.0",
  "description": "Browser extension that quickly and easily copies info on the current page using a simple and unique template system",
  "private": true,
  "homepage": "https://tmplat.com",
  "bugs": {
    "url": "https://github.com/tmplat-extension/tmplat/issues"
  },
  "license": "MIT",
  "author": {
    "name": "airmrcr",
    "url": "https://github.com/airmrcr"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tmplat-extension/tmplat.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm build:prod",
    "build:dev": "pnpm clean && pnpm type:check && rolldown -c rolldown.config.mjs",
    "build:dev:nocheck": "pnpm clean && rolldown -c rolldown.config.mjs",
    "build:dev:watch": "rolldown -c rolldown.config.mjs --watch",
    "build:prod": "pnpm clean && pnpm type:check && rolldown -c rolldown.config.mjs --minify && pnpm compress",
    "check": "pnpm type:check && pnpm type:check:e2e && pnpm lint:check && pnpm format:check",
    "clean": "rimraf dist",
    "compress": "cd dist/temp && bestzip ../tmplat.zip \"*\"",
    "dev": "concurrently -n build:dev,type:check -c blue,magenta \"pnpm:build:dev:watch\" \"pnpm:type:check:watch\"",
    "fix": "pnpm lint && pnpm format",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "test": "pnpm test:unit",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report dist/playwright-report",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "type:check": "tsc",
    "type:check:e2e": "tsc -p e2e/tsconfig.json",
    "type:check:watch": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-data-grid": "^9.17.0",
    "allfulfilled": "^0.2.0",
    "chalk": "^6.0.1",
    "es-toolkit": "^1.53.2",
    "europa": "^6.0.0",
    "inversify": "^8.3.0",
    "luxon": "^3.7.2",
    "react": "^19.3.1",
    "react-async": "^10.0.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "tmplat-mustache": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.7",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "bestzip": "^4.0.3",
    "concurrently": "^10.0.7",
    "eslint-plugin-import-x": "^4.18.1",
    "http-server": "^14.1.1",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "rimraf": "^6.1.4",
    "rolldown": "^1.3.1",
    "sass": "^1.108.1",
    "typescript": "^7.0.2",
    "user-agent-data-types": "^0.4.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.15"
  }
}
