{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "oxc", "react", "typescript", "unicorn"],
  "jsPlugins": [{ "name": "import-x-js", "specifier": "eslint-plugin-import-x" }],
  "ignorePatterns": ["dist/**", "src/vendor/**"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "settings": {
    "import-x/internal-regex": "^extension/"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "all",
        "argsIgnorePattern": "^_",
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "@testing-library/jest-dom/vitest",
          "reflect-metadata",
          "extension/common/system/browser-api.polyfill",
          "extension/ui/**/*.scss"
        ]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": true,
        "fixStyle": "inline-type-imports",
        "prefer": "type-imports"
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "import/first": "error",
        "import/no-duplicates": ["error", { "preferInline": true }],
        "import-x-js/no-extraneous-dependencies": [
          "error",
          {
            "devDependencies": false,
            "optionalDependencies": false,
            "peerDependencies": false,
            "includeInternal": false,
            "includeTypes": false
          }
        ],
        "import-x-js/order": [
          "error",
          {
            "alphabetize": { "order": "asc", "caseInsensitive": true },
            "named": true,
            "newlines-between": "never"
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "src/lib/test/**",
        "e2e/**",
        "*.config.ts",
        "*.config.mts",
        "*.config.mjs"
      ],
      "rules": {
        "import-x-js/no-extraneous-dependencies": ["error", { "devDependencies": true }]
      }
    }
  ]
}
