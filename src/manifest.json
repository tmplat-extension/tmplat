{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "0.0.0",
  "description": "__MSG_description__",
  "icons": {
    "16": "img/icon_16.png",
    "19": "img/icon_19.png",
    "24": "img/icon_24.png",
    "32": "img/icon_32.png",
    "48": "img/icon_48.png",
    "64": "img/icon_64.png",
    "72": "img/icon_72.png",
    "96": "img/icon_96.png",
    "128": "img/icon_128.png"
  },
  "action": {
    "default_icon": {
      "19": "img/icon_19.png"
    },
    "default_popup": "popup.html",
    "default_title": "__MSG_name__"
  },
  "background": {
    "service_worker": "lib/worker/background.js"
  },
  "content_scripts": [
    {
      "js": ["lib/content/any-content.js"],
      "matches": ["http://*/*", "https://*/*"],
      "run_at": "document_idle"
    },
    {
      "js": ["lib/content/homepage-content.js"],
      "matches": ["http://*.tmplat.com/*", "https://*.tmplat.com/*"],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "en",
  "homepage_url": "https://tmplat.com",
  "minimum_chrome_version": "152",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "clipboardWrite",
    "contextMenus",
    "cookies",
    "geolocation",
    "identity",
    "notifications",
    "offscreen",
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_permissions": [],
  "host_permissions": ["http://*/*", "https://*/*"],
  "optional_host_permissions": []
}
